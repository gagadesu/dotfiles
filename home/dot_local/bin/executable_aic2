#!/usr/bin/python3
"""Generate Git commit messages through an MBP-hosted aicommit2 bridge."""

import argparse
import http.client
import json
import os
import socket
import stat
import subprocess
import sys
from typing import Any, List, Optional


MAX_CONTEXT_BYTES = 10 * 1024 * 1024
MAX_RESPONSE_BYTES = 1024 * 1024
BRIDGE_TIMEOUT_SECONDS = 12 * 60
GIT_EXCLUDES = (
    ":(exclude)package-lock.json",
    ":(exclude)pnpm-lock.yaml",
    ":(exclude)*.lock",
    ":(exclude)*.lockb",
)


class ClientError(Exception):
    """An expected error that should be shown without a traceback."""


class UnixHTTPConnection(http.client.HTTPConnection):
    def __init__(self, socket_path: str, timeout: int) -> None:
        super().__init__("localhost", timeout=timeout)
        self.socket_path = socket_path

    def connect(self) -> None:
        self.sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        self.sock.settimeout(self.timeout)
        self.sock.connect(self.socket_path)


def run_git(arguments: List[str], cwd: Optional[str] = None, allow_failure: bool = False) -> bytes:
    completed = subprocess.run(
        ["/usr/bin/git", *arguments],
        cwd=cwd,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )
    if completed.returncode != 0 and not allow_failure:
        detail = completed.stderr.decode("utf-8", "replace").strip()
        raise ClientError(detail or f"git {' '.join(arguments)} failed")
    return completed.stdout if completed.returncode == 0 else b""


def collect_context() -> bytes:
    repository = run_git(["rev-parse", "--show-toplevel"]).decode("utf-8", "replace").strip()
    if not repository:
        raise ClientError("Unable to determine the Git repository root")

    files_raw = run_git(
        ["diff", "--cached", "--diff-algorithm=minimal", "-U3", "--name-only", "-z", *GIT_EXCLUDES],
        cwd=repository,
    )
    files = [os.fsdecode(item) for item in files_raw.split(b"\0") if item]
    if not files:
        raise ClientError("No staged changes found. Stage files with `git add` first.")

    diff = run_git(
        ["diff", "--cached", "--diff-algorithm=minimal", "-U3", *GIT_EXCLUDES],
        cwd=repository,
    ).decode("utf-8", "replace")
    if not diff.strip():
        diff = f"Files changed: {', '.join(files)}"

    branch_name = run_git(["symbolic-ref", "--quiet", "--short", "HEAD"], cwd=repository, allow_failure=True)
    recent = run_git(["log", "--format=%s", "-5"], cwd=repository, allow_failure=True)

    context = {
        "version": 1,
        "files": files,
        "diff": diff,
        "branchName": branch_name.decode("utf-8", "replace").strip(),
        "recentCommits": [line for line in recent.decode("utf-8", "replace").splitlines() if line.strip()],
    }
    payload = json.dumps(context, ensure_ascii=True, separators=(",", ":")).encode("utf-8")
    if len(payload) > MAX_CONTEXT_BYTES:
        raise ClientError(
            f"Staged context is {len(payload)} bytes; the bridge limit is {MAX_CONTEXT_BYTES} bytes. "
            "Stage a smaller commit."
        )
    return payload


def request_messages(socket_path: str, payload: bytes) -> bytes:
    if not os.path.isabs(socket_path):
        raise ClientError("AIC2_BRIDGE_SOCKET must be an absolute path")
    try:
        socket_mode = os.stat(socket_path).st_mode
    except OSError as error:
        raise ClientError(f"Bridge socket is unavailable: {error}") from error
    if not stat.S_ISSOCK(socket_mode):
        raise ClientError("AIC2_BRIDGE_SOCKET does not point to a Unix socket")

    connection = UnixHTTPConnection(socket_path, BRIDGE_TIMEOUT_SECONDS)
    try:
        connection.request(
            "POST",
            "/v1/generate",
            body=payload,
            headers={"Content-Type": "application/json", "Content-Length": str(len(payload))},
        )
        response = connection.getresponse()
        body = response.read(MAX_RESPONSE_BYTES + 1)
    except (OSError, http.client.HTTPException) as error:
        raise ClientError(f"Bridge request failed: {error}") from error
    finally:
        connection.close()

    if len(body) > MAX_RESPONSE_BYTES:
        raise ClientError("Bridge response exceeded the 1 MiB safety limit")
    if response.status != 200:
        try:
            error_body = json.loads(body.decode("utf-8"))
            summary = str(error_body.get("error", f"HTTP {response.status}"))
            detail = str(error_body.get("detail", "")).strip()
        except (UnicodeDecodeError, json.JSONDecodeError, AttributeError):
            summary = f"HTTP {response.status}"
            detail = body.decode("utf-8", "replace").strip()
        raise ClientError(f"{summary}: {detail}" if detail else summary)
    return body


def parse_messages(body: bytes) -> List[Any]:
    messages = []
    for line in body.decode("utf-8").splitlines():
        if not line.strip():
            continue
        try:
            message = json.loads(line)
        except json.JSONDecodeError as error:
            raise ClientError(f"Bridge returned invalid JSON: {error}") from error
        if not isinstance(message, dict) or not isinstance(message.get("subject"), str):
            raise ClientError("Bridge returned a commit message in an unexpected format")
        messages.append(message)
    if not messages:
        raise ClientError("Bridge returned no commit messages")
    return messages


def print_messages(messages: List[Any]) -> None:
    rendered = []
    for message in messages:
        sections = [message["subject"].strip()]
        for field in ("body", "footer"):
            value = message.get(field)
            if isinstance(value, str) and value.strip():
                sections.append(value.strip())
        rendered.append("\n\n".join(sections))
    sys.stdout.write("\n\n---\n\n".join(rendered) + "\n")


def main() -> int:
    parser = argparse.ArgumentParser(
        prog="aic2",
        description="Generate a message for staged Git changes through the MBP aicommit2 bridge.",
    )
    parser.add_argument("--output", choices=("text", "json"), default="text", help="output format (default: text)")
    arguments = parser.parse_args()

    socket_path = os.environ.get("AIC2_BRIDGE_SOCKET", "")
    if not socket_path:
        raise ClientError("No MBP bridge is available. Connect with `aicommit2 remote-shell m4` from the MBP.")

    body = request_messages(socket_path, collect_context())
    if arguments.output == "json":
        sys.stdout.buffer.write(body if body.endswith(b"\n") else body + b"\n")
    else:
        print_messages(parse_messages(body))
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except ClientError as error:
        print(f"aic2: {error}", file=sys.stderr)
        raise SystemExit(1)
