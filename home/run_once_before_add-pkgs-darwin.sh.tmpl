{{- if eq .chezmoi.os "darwin" -}}
#!/bin/bash

set -euo pipefail

case "$(/usr/bin/uname -m)" in
    arm64) brew_bin="/opt/homebrew/bin/brew" ;;
    x86_64) brew_bin="/usr/local/bin/brew" ;;
    *)
        echo "Unsupported macOS architecture: $(/usr/bin/uname -m)" >&2
        exit 1
        ;;
esac

command_line_tools_are_usable() {
    /usr/bin/xcode-select --print-path >/dev/null 2>&1 &&
        /usr/bin/xcrun clang --version >/dev/null 2>&1
}

if ! command_line_tools_are_usable || [ ! -x "$brew_bin" ]; then
    if [ ! -t 0 ]; then
        echo "Installing Xcode Command Line Tools or Homebrew requires an interactive terminal." >&2
        echo "Re-run chezmoi init/apply from an interactive terminal." >&2
        exit 1
    fi

    echo "Bootstrapping Xcode Command Line Tools and Homebrew with the official installer..."
    /usr/bin/sudo -v

    temp_dir=$(/usr/bin/mktemp -d)
    trap '/bin/rm -rf "$temp_dir"' EXIT
    /usr/bin/curl -fsSL --retry 3 \
        -o "${temp_dir}/install-homebrew.sh" \
        https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh
    NONINTERACTIVE=1 /bin/bash "${temp_dir}/install-homebrew.sh"
    trap - EXIT
    /bin/rm -rf "$temp_dir"
fi

if ! command_line_tools_are_usable; then
    echo "Xcode Command Line Tools verification failed." >&2
    exit 1
fi

if [ ! -x "$brew_bin" ]; then
    echo "Homebrew installation verification failed: ${brew_bin} was not found." >&2
    exit 1
fi

eval "$("$brew_bin" shellenv)"

formulae=(
    eza
    fzf
    lazydocker
    neovim
    oh-my-posh
    ripgrep
    tmux
    zoxide
)

missing_formulae=()
for formula in "${formulae[@]}"; do
    if ! brew list --formula "$formula" >/dev/null 2>&1; then
        missing_formulae+=("$formula")
    fi
done

if [ ${#missing_formulae[@]} -gt 0 ]; then
    echo "Installing missing Homebrew formulae: ${missing_formulae[*]}"
    brew install "${missing_formulae[@]}"
else
    echo "All common macOS formulae are already installed."
fi

commands=(eza fzf lazydocker nvim oh-my-posh rg tmux zoxide)
for tool in "${commands[@]}"; do
    if ! command -v "$tool" >/dev/null 2>&1; then
        echo "Command verification failed: ${tool}" >&2
        exit 1
    fi
done

echo "Installed lazydocker version:"
lazydocker --version
echo "macOS base tools setup complete!"

{{ end -}}
